{
  "name": "@litanbid/link-qr",
  "version": "0.1.0",
  "description": "Self-hosted URL to PNG QR code generator, with a web UI and API.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "bin": {
    "link-qr": "./bin/link-qr.js"
